{
  "name": "@rill/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Model Context Protocol server for Rill agent payments",
  "type": "module",
  "bin": {
    "rill-mcp": "./dist/index.js",
    "rill-mcp-http": "./dist/http-entry.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rillongit/mcp.git"
  },
  "homepage": "https://userill.com/docs/mcp/overview",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-entry.js",
    "dev": "tsx src/index.ts",
    "dev:http": "RILL_MCP_TRANSPORT=http tsx src/http-entry.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "smoke:env": "tsx scripts/smoke-env-config.ts",
    "smoke:tools": "tsx scripts/smoke-tools.ts",
    "smoke:api": "tsx scripts/smoke-api.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rill/shared": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
