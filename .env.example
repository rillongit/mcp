# API base (production: https://api.userill.com)
RILL_API_URL=http://localhost:3001
RILL_VW_KEY=
RILL_SELLER_KEY=
RILL_OWNER_JWT=
# live (default) | test — owner JWT / register money mode (X-Rill-Environment)
RILL_ENVIRONMENT=live

# Server
RILL_MCP_TRANSPORT=stdio
PORT=3101
RILL_MCP_PUBLIC_URL=http://localhost:3101
RILL_MCP_BEARER_TOKEN=
# Set true to require transport bearer on /mcp (production default: required unless explicitly false)
RILL_MCP_REQUIRE_AUTH=false
RILL_MCP_HOST=0.0.0.0
RILL_MCP_ALLOWED_HOSTS=
RILL_MCP_TRUST_PROXY=false
RILL_MCP_TRUSTED_PROXY_HOPS=1
RILL_MCP_RATE_LIMIT_RPM=120
RILL_MCP_MAX_SESSIONS=2000
RILL_MCP_SESSION_TTL_MS=1800000
RILL_MCP_MAX_BODY_BYTES=4194304

# Connect-with OAuth (must match API; requires INTERNAL_API_KEY for introspect)
RILL_MERCHANT_OAUTH_ENABLED=false
INTERNAL_API_KEY=
